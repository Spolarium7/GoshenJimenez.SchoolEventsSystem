@page "/account/forgot-password"
@model ForgotPassword    


<form method="post" class="mt-5">
  <div class="mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
  </div>    
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">Email address</label>
    <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" asp-for="@Model.ForgotPasswordDto.Username">
    <span asp-validation-for="@Model.ForgotPasswordDto.Username" class="text-danger"></span>
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
</form>