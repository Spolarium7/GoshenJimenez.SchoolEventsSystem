@page "/account/verify-forgot-password"
@model VerifyForgotPassword


<form method="post" class="mt-5">
  <div class="mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
  </div>    
  <div class="mb-3">
    <span class="text-info">Please enter a new password for your account.</span>
  </div>
  <div class="mb-3">
    <input type="hidden" class="form-control" id="exampleInputUserId1" asp-for="@Model.VerifyForgotPasswordDto!.UserId">
    <label for="exampleInputPassword1" class="form-label">Password</label>
    <input type="password" class="form-control" id="exampleInputPassword1" asp-for="@Model.VerifyForgotPasswordDto!.Password">
    <span asp-validation-for="@Model.VerifyForgotPasswordDto!.Password" class="text-danger"></span>
  </div>
  <div class="mb-3">
    <label for="exampleInputConfirmPassword1" class="form-label">Confirm Password</label>
    <input type="password" class="form-control" id="exampleInputConfirmPassword1" asp-for="@Model.VerifyForgotPasswordDto!.ConfirmPassword">
    <span asp-validation-for="@Model.VerifyForgotPasswordDto!.ConfirmPassword" class="text-danger"></span>
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
</form>