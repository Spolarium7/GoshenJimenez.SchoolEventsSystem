@page "/account/change-password"
@model ChangePassword


<form method="post" class="mt-5">
  <div class="mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
  </div>    
  <div class="mb-3">
    <img class="card-img-top mb-3" style="max-width: 200px; height: auto;" src="@Model.ChangePasswordDto.ProfileImage" alt="@Model.ChangePasswordDto.Username" />
  </div>
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">Email address</label>
    <p class="card-text">@Model.ChangePasswordDto.Username </p>
  </div>
  <div class="mb-3">
    <label for="exampleInputPassword1" class="form-label">Current Password</label>
    <input type="password" class="form-control" id="exampleInputPassword1" asp-for="@Model.ChangePasswordDto.CurrentPassword">
    <span asp-validation-for="@Model.ChangePasswordDto.CurrentPassword" class="text-danger"></span>
  </div>
  <div class="mb-3">
    <label for="exampleInputNewPassword1" class="form-label">New Password</label>
    <input type="password" class="form-control" id="exampleInputNewPassword1" asp-for="@Model.ChangePasswordDto.NewPassword">
    <span asp-validation-for="@Model.ChangePasswordDto.NewPassword" class="text-danger"></span>
  </div>
  <div class="mb-3">
    <label for="exampleInputConfirmNewPassword1" class="form-label">Confirm New Password</label>
    <input type="password" class="form-control" id="exampleInputConfirmNewPassword1" asp-for="@Model.ChangePasswordDto.ConfirmNewPassword">
    <span asp-validation-for="@Model.ChangePasswordDto.ConfirmNewPassword" class="text-danger"></span>
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
</form>