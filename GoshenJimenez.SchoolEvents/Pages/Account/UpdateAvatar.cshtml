@page "/account/update-avatar"
@model UpdateAvatar


<form method="post" class="mt-5" enctype="multipart/form-data">
  <div class="mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
  </div>    
  <div class="mb-3">
    <img class="card-img-top mb-3" style="max-width: 200px; height: auto;" src="@Model.UserAvatarDto.ProfileImage" alt="@Model.UserAvatarDto.FirstName @Model.UserAvatarDto.LastName">
  </div>
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">New Avatar</label>
    <input type="file" class="form-control" id="exampleInputEmail1" asp-for="@Model.UserAvatarDto.AvatarImage">
    <span asp-validation-for="@Model.UserAvatarDto.AvatarImage" class="text-danger"></span>
  </div>  
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">Email address</label>
    <p class="card-text">@Model.UserAvatarDto.Username </p>
  </div>
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">Name</label>
    <p class="card-text">@Model.UserAvatarDto.FirstName @Model.UserAvatarDto.LastName</p>
  </div>
  <button type="submit" class="btn btn-primary">Submit</button>
</form>