@page "/manage/users"
@model GoshenJimenez.SchoolEvents.Pages.Manage.Users.Index


<H1>Manage Users</H1>

<div class="input-group mb-3">
    <a href="/students/create" class="btn btn-outline-secondary" type="button"><i class="bi bi-plus-circle"></i> Add New Student</a>
</div>

<div class="input-group mb-3">
  <input id="keyword" type="text" class="form-control" placeholder="Search by Fullname" 
    aria-label="Fullname" aria-describedby="basic-addon2" value="@Model.Keyword">
  <div class="input-group-append">
    <button class="btn btn-outline-secondary" type="button" onclick="search()"><i class="bi bi-search"></i></button>
  </div>
</div>

<div class="form-check form-switch">
  <input class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" @(Model.ShowDeletedUsers == true ? "checked" : "") onchange="toggleDeletedUsers(@(Model.ShowDeletedUsers == true ? "false" : "true"))">
  <label class="form-check-label" for="flexSwitchCheckChecked">Show Deleted Users</label>
</div>

<table class="table">
  <thead>
    <tr>
      <th scope="col">Username</th>
      <th scope="col">Name</th>
      <th scope="col">Date Of Birth</th>
      <th scope="col">Actions</th>      
    </tr>
  </thead>
  <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.UserName</td>
            <td>@user.FirstName @user.LastName</td>
            <td>@user.DateOfBirth.ToString("MM/dd/yyyy")</td>
            <td>
              <button type="button" class="btn btn-secondary" onclick="confirmDelete('@user.Id','@user.FirstName @user.LastName')"><i class="bi bi-x-circle"></i></button>
            </td>
        </tr>
    }            
  </tbody>
</table>


@{
  if(Model.Users.Count > 0)
  {
    <nav aria-label="Page navigation example">
      <ul class="pagination">
        @{
         <li class="page-item"><a class="page-link" href="~/users?pageSize=@this.Model.PageSize&pageIndex=1&sortBy=@this.Model.SortBy&sortOrder=@this.Model.SortOrder&keyword=@this.Model.Keyword&isDeleted=@this.Model.ShowDeletedUsers">First</a></li>         
          if(this.Model.PageIndex > 1)
          {
            <li class="page-item">
              <a class="page-link" href="~/users?pageSize=@this.Model.PageSize&pageIndex=@(this.Model.PageIndex-1)&sortBy=@this.Model.SortBy&sortOrder=@this.Model.SortOrder&keyword=@this.Model.Keyword&isDeleted=@this.Model.ShowDeletedUsers" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
              </a>
            </li>
          }
        }

        <li class="page-item"><a class="page-link" href="#" aria-disabled="true" disabled>@this.Model.PageIndex</a></li>

        @{
          if(this.Model.PageIndex < this.Model.TotalPages)
          {
            <li class="page-item">
              <a class="page-link" href="~/users?pageSize=@this.Model.PageSize&pageIndex=@(this.Model.PageIndex+1)&sortBy=@this.Model.SortBy&sortOrder=@this.Model.SortOrder&keyword=@this.Model.Keyword&isDeleted=@this.Model.ShowDeletedUsers" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
              </a>
            </li>
          }
        <li class="page-item"><a class="page-link" href="~/users?pageSize=@this.Model.PageSize&pageIndex=@this.Model.TotalPages&sortBy=@this.Model.SortBy&sortOrder=@this.Model.SortOrder&keyword=@this.Model.Keyword&isDeleted=@this.Model.ShowDeletedUsers">Last</a></li>
        }
      </ul>
    </nav>
  }
}

<div class="modal" tabindex="-1" id="deleteModal">
  <form method="post" asp-page-handler="DeleteUser">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Delete</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete : <span id="deleteUserName"></span></p>
        </div>
        <div class="modal-footer">
          <input type="hidden" name="userId" value="" id="deleteUserId"/>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
        </div>
      </div>
    </div>
  </form>  
</div>

<script>
    function search(){
        window.location.href = `users?keyword=${document.getElementById("keyword").value}`;
    }

    document.getElementById("keyword")
        .addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault(); // prevent form submit
                search();
            }
    });    

    function confirmDelete(userId, userName) {
      $("#deleteUserName").html(userName);   
      $("#deleteUserId").val(userId);
      $("#deleteModal").modal("show");
    }

    function toggleDeletedUsers(showDeleted) {
      window.location.href = `/manage/users?pageSize=@this.Model.PageSize&pageIndex=@this.Model.TotalPages&sortBy=@this.Model.SortBy&sortOrder=@this.Model.SortOrder&keyword=@this.Model.Keyword&isDeleted=${showDeleted}`;
    }
</script>